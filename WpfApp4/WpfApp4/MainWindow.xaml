<Window x:Class="ChemistryIS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChemistryIS" 
        xmlns:vm="clr-namespace:ChemistryIS.ViewModels"
        mc:Ignorable="d"
        Title="Химия: Информационная система" Height="700" Width="1100">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="ElementButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#e0f0ff"/>
            <Setter Property="BorderBrush" Value="#0078D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="ToolTip" Value="{Binding NameRu}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b3d9ff"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto" MinHeight="180"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#ccc" BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding Topics}" 
                         SelectedItem="{Binding SelectedTopic}"
                         DisplayMemberPath="Title"
                         FontSize="14"
                         Padding="5"/>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#ddd"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedTopic.Title}" 
                               FontSize="24" FontWeight="Bold" Foreground="#0078D7" Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding SelectedTopic.Description}" 
                               FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <ItemsControl ItemsSource="{Binding SelectedTopic.Contents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="{Binding SectionTitle}" 
                                               FontWeight="Bold" FontSize="16" Foreground="#333"/>
                                    <TextBlock Text="{Binding BodyText}" 
                                               TextWrapping="Wrap" FontSize="14" Margin="5,5,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GroupBox Grid.Row="2" Header="Поиск элемента (Таблица Менделеева)" 
                  BorderBrush="#0078D7" BorderThickness="2" Margin="0,5,0,0">

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Введите символ, название или номер:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="16" Padding="8" Margin="0,0,0,10"/>

                    <Button Content=" Открыть таблицу Менделеева" 
                            Command="{Binding OpenPeriodicTableCommand}"
                            Padding="10,5" FontSize="14"
                            Background="#e0f0ff" BorderBrush="#0078D7"
                            HorizontalAlignment="Left" Margin="0,0,0,10" Click="Button_Click_1"/>

                    <Button Content="НАЙТИ" Command="{Binding SearchElementCommand}" 
                            Padding="15,8" FontSize="14" FontWeight="Bold"
                            Background="#0078D7" Foreground="White"
                            HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="Red" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="2" 
                        Background="#f0f8ff" 
                        BorderBrush="#0078D7" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="15"
                        Visibility="{Binding FoundElement, Converter={StaticResource NullToVisibilityConverter}}">

                    <StackPanel DataContext="{Binding FoundElement}">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="{Binding NameRu}" 
                                       FontSize="22" FontWeight="Bold" 
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Symbol}" 
                                       FontSize="48" FontWeight="Bold" 
                                       Foreground="#0078D7" 
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#ccc" Margin="0,0,0,10"/>

                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                            <Run FontWeight="Bold">Атомный номер:</Run>
                            <Run Text="{Binding AtomicNumber}"/>
                        </TextBlock>

                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                            <Run FontWeight="Bold">Атомная масса:</Run>
                            <Run Text="{Binding AtomicMass, StringFormat={}{0:F4}}"/>
                        </TextBlock>

                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                            <Run FontWeight="Bold">Категория:</Run>
                            <Run Text="{Binding Category}"/>
                        </TextBlock>

                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                            <Run FontWeight="Bold">Электронная конфигурация:</Run>
                            <LineBreak/>
                            <Run Text="{Binding ElectronConfig}" Foreground="#444" FontFamily="Consolas"/>
                        </TextBlock>

                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</Window>